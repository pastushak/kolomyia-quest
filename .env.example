# ── База даних ──────────────────────────────────────────
# MongoDB Atlas. Через DNS на Windows використовуй ПРЯМИЙ рядок (не mongodb+srv://):
# mongodb://user:pass@host-00,host-01,host-02/kolomyia_quest?replicaSet=...&ssl=true&authSource=admin
MONGODB_URI=

# ── NextAuth (автентифікація) ───────────────────────────
# Секрет для підпису сесій. Згенеруй: npx auth secret   (або openssl rand -base64 32)
AUTH_SECRET=

# Локально має бути http://localhost:3000 (НЕ Vercel-URL) — інакше Google OAuth ламається
AUTH_URL=http://localhost:3000

# Google OAuth — з Google Cloud Console → Credentials → OAuth 2.0 Client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Адмін-доступ ────────────────────────────────────────
# Email-и адмінів через кому (отримують роль admin при логіні через Google)
# Напр.: roman@gmail.com, team@gmail.com
ADMIN_EMAILS=

# Аварійний пароль для входу в адмінку (шлях без Google — /admin/login)
ADMIN_PASSWORD=